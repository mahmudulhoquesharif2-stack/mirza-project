generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  name       String?
  email      String    @unique
  password   String
  role       String    @default("student")
  background String    @default("GENERAL") // "MADRASAH" or "GENERAL"
  phone      String?
  country    String?
  image      String?
  createdAt  DateTime  @default(now())
  enrollments Enrollment[]
  payments    Payment[]
}

model Course {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  description    String?
  priceMadrasah  Int       @default(3900)  // in cents, 3900 = 39 BDT
  priceGeneral   Int       @default(5300)  // in cents, 5300 = 53 BDT
  createdAt      DateTime  @default(now())
  modules        Module[]
  enrollments    Enrollment[]
  payments       Payment[]
}

model Module {
  id        Int      @id @default(autoincrement())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  Int
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  lessons   Lesson[]
}

model Lesson {
  id         Int      @id @default(autoincrement())
  module     Module   @relation(fields: [moduleId], references: [id])
  moduleId   Int
  title      String
  order      Int      @default(0)
  contentUrl String?  // Zoom/YouTube link (hidden if payment not completed)
  createdAt  DateTime @default(now())
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  Int
  createdAt DateTime @default(now())
}

// PaymentStatus enum removed because SQLite connector doesn't support native enums.
// Use string values in `Payment.status` and enforce allowed values in application logic.

model Payment {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  course          Course?       @relation(fields: [courseId], references: [id])
  courseId        Int?
  amount          Int           // amount in cents
  currency        String        @default("USD")
  method          String
  stripeSessionId String?       // Stripe checkout/session id
  transactionId   String?       // Manual Bkash/Nagad txn id
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
}

// Raw visit records (optional)
model Visit {
  id        Int      @id @default(autoincrement())
  path      String
  ip        String?
  country   String?
  createdAt DateTime @default(now())
}

// Daily aggregated visitor counts for analytics
model DailyVisitor {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
}
